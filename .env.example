# ---------------------------------------------------------------------------
# HussCut — variables d'environnement (copier en .env.local, ne jamais committer)
# ---------------------------------------------------------------------------

# URL publique du site, sans barre finale. Sert aux URL canoniques, hreflang,
# Open Graph et au sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# « production » rend le site indexable (robots, sitemap, en-têtes) ET active le
# contrôle de publication : le build échoue tant que des informations légales
# obligatoires manquent dans src/content/business.ts. Toute autre valeur = noindex.
SITE_ENV=preview

# --- Envoi du formulaire par e-mail (optionnel) -----------------------------
# Tant que ces trois variables ne sont pas toutes renseignées, le formulaire de
# commande fonctionne en mode aperçu : rien n'est transmis, et le visiteur en est informé.
# Le prestataire prévu est Resend (https://resend.com). Le domaine d'envoi doit
# y être vérifié.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
